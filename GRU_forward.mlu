#include <bang.h>
#include <cnrt.h>
#include <math.h>
#include <stdint.h>
#include <torch/extension.h>
#include <framework/core/MLUStream.h>

#define BATCH 32
#define SEQ 128
#define INPUT 256
#define HIDDEN 512
#define TOTAL (BATCH * HIDDEN)
#define TASK_NUM 512

__mlu_func__ float sigmoidf_local(float x) {
  if (x > 20.0f) return 1.0f;
  if (x < -20.0f) return 0.0f;
  return 1.0f / (1.0f + expf(-x));
}

__mlu_func__ float tanhf_local(float x) {
  if (x > 10.0f) return 1.0f;
  if (x < -10.0f) return -1.0f;
  float e = expf(2.0f * x);
  return (e - 1.0f) / (e + 1.0f);
}

__mlu_entry__ void ZeroStateKernel(half *state0_a, half *state0_b,
                                   half *state1_a, half *state1_b) {
  for (uint32_t idx = taskId; idx < TOTAL; idx += taskDim) {
    state0_a[idx] = (half)0.0f;
    state0_b[idx] = (half)0.0f;
    state1_a[idx] = (half)0.0f;
    state1_b[idx] = (half)0.0f;
  }
}

__mlu_entry__ void GRULayer0StepKernel(
    const half *x, const half *weight_ih, const half *weight_hh,
    const half *bias_ih, const half *bias_hh, const half *prev_state,
    half *next_state, half *layer0, uint32_t t) {
  for (uint32_t idx = taskId; idx < TOTAL; idx += taskDim) {
    uint32_t h = idx % HIDDEN;
    uint32_t b = idx / HIDDEN;
    float prev = (float)prev_state[idx];
    float gi_r = (float)bias_ih[h];
    float gi_z = (float)bias_ih[HIDDEN + h];
    float gi_n = (float)bias_ih[2 * HIDDEN + h];
    float gh_r = (float)bias_hh[h];
    float gh_z = (float)bias_hh[HIDDEN + h];
    float gh_n = (float)bias_hh[2 * HIDDEN + h];

    const half *x_base = x + ((uint64_t)b * SEQ + t) * INPUT;
    for (uint32_t k = 0; k < INPUT; ++k) {
      float xv = (float)x_base[k];
      gi_r += xv * (float)weight_ih[h * INPUT + k];
      gi_z += xv * (float)weight_ih[(HIDDEN + h) * INPUT + k];
      gi_n += xv * (float)weight_ih[(2 * HIDDEN + h) * INPUT + k];
    }
    const half *state_base = prev_state + (uint64_t)b * HIDDEN;
    for (uint32_t k = 0; k < HIDDEN; ++k) {
      float hv = (float)state_base[k];
      gh_r += hv * (float)weight_hh[h * HIDDEN + k];
      gh_z += hv * (float)weight_hh[(HIDDEN + h) * HIDDEN + k];
      gh_n += hv * (float)weight_hh[(2 * HIDDEN + h) * HIDDEN + k];
    }
    float r = sigmoidf_local(gi_r + gh_r);
    float z = sigmoidf_local(gi_z + gh_z);
    float n = tanhf_local(gi_n + r * gh_n);
    float hnew = (1.0f - z) * n + z * prev;
    next_state[idx] = (half)hnew;
    layer0[((uint64_t)b * SEQ + t) * HIDDEN + h] = (half)hnew;
  }
}

__mlu_entry__ void GRULayer1StepKernel(
    const half *layer0, const half *weight_ih, const half *weight_hh,
    const half *bias_ih, const half *bias_hh, const half *prev_state,
    half *next_state, half *out, uint32_t t) {
  for (uint32_t idx = taskId; idx < TOTAL; idx += taskDim) {
    uint32_t h = idx % HIDDEN;
    uint32_t b = idx / HIDDEN;
    float prev = (float)prev_state[idx];
    float gi_r = (float)bias_ih[h];
    float gi_z = (float)bias_ih[HIDDEN + h];
    float gi_n = (float)bias_ih[2 * HIDDEN + h];
    float gh_r = (float)bias_hh[h];
    float gh_z = (float)bias_hh[HIDDEN + h];
    float gh_n = (float)bias_hh[2 * HIDDEN + h];

    const half *x_base = layer0 + ((uint64_t)b * SEQ + t) * HIDDEN;
    for (uint32_t k = 0; k < HIDDEN; ++k) {
      float xv = (float)x_base[k];
      gi_r += xv * (float)weight_ih[h * HIDDEN + k];
      gi_z += xv * (float)weight_ih[(HIDDEN + h) * HIDDEN + k];
      gi_n += xv * (float)weight_ih[(2 * HIDDEN + h) * HIDDEN + k];
    }
    const half *state_base = prev_state + (uint64_t)b * HIDDEN;
    for (uint32_t k = 0; k < HIDDEN; ++k) {
      float hv = (float)state_base[k];
      gh_r += hv * (float)weight_hh[h * HIDDEN + k];
      gh_z += hv * (float)weight_hh[(HIDDEN + h) * HIDDEN + k];
      gh_n += hv * (float)weight_hh[(2 * HIDDEN + h) * HIDDEN + k];
    }
    float r = sigmoidf_local(gi_r + gh_r);
    float z = sigmoidf_local(gi_z + gh_z);
    float n = tanhf_local(gi_n + r * gh_n);
    float hnew = (1.0f - z) * n + z * prev;
    next_state[idx] = (half)hnew;
    out[((uint64_t)b * SEQ + t) * HIDDEN + h] = (half)hnew;
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor weight_ih_l0,
                        torch::Tensor weight_hh_l0, torch::Tensor bias_ih_l0,
                        torch::Tensor bias_hh_l0, torch::Tensor weight_ih_l1,
                        torch::Tensor weight_hh_l1, torch::Tensor bias_ih_l1,
                        torch::Tensor bias_hh_l1, int input_size,
                        int hidden_size, int num_layers) {
  auto output = x.new_empty({x.size(0), x.size(1), hidden_size});
  auto layer0 = x.new_empty({x.size(0), x.size(1), hidden_size});
  auto state0_a = x.new_empty({x.size(0), hidden_size});
  auto state0_b = x.new_empty({x.size(0), hidden_size});
  auto state1_a = x.new_empty({x.size(0), hidden_size});
  auto state1_b = x.new_empty({x.size(0), hidden_size});

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t task_dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
  ZeroStateKernel<<<task_dim, ktype, queue>>>(
      (half *)state0_a.data_ptr(), (half *)state0_b.data_ptr(),
      (half *)state1_a.data_ptr(), (half *)state1_b.data_ptr());
  for (uint32_t t = 0; t < SEQ; ++t) {
    half *prev = (half *)((t & 1) ? state0_b.data_ptr() : state0_a.data_ptr());
    half *next = (half *)((t & 1) ? state0_a.data_ptr() : state0_b.data_ptr());
    GRULayer0StepKernel<<<task_dim, ktype, queue>>>(
        (const half *)x.data_ptr(), (const half *)weight_ih_l0.data_ptr(),
        (const half *)weight_hh_l0.data_ptr(), (const half *)bias_ih_l0.data_ptr(),
        (const half *)bias_hh_l0.data_ptr(), prev, next, (half *)layer0.data_ptr(),
        t);
  }
  for (uint32_t t = 0; t < SEQ; ++t) {
    half *prev = (half *)((t & 1) ? state1_b.data_ptr() : state1_a.data_ptr());
    half *next = (half *)((t & 1) ? state1_a.data_ptr() : state1_b.data_ptr());
    GRULayer1StepKernel<<<task_dim, ktype, queue>>>(
        (const half *)layer0.data_ptr(), (const half *)weight_ih_l1.data_ptr(),
        (const half *)weight_hh_l1.data_ptr(), (const half *)bias_ih_l1.data_ptr(),
        (const half *)bias_hh_l1.data_ptr(), prev, next, (half *)output.data_ptr(),
        t);
  }
  return output;
}
