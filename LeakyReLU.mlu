#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>
#include <framework/core/MLUStream.h>

#define TILE_ELEM 16384
#define TASK_ELEM_SLICE TILE_ELEM
#define TASK_NUM 32

__mlu_entry__ void LeakyReLUKernel(const float *x, float *y, uint32_t total,
                                   float negative_slope) {
  __nram__ float nram_x[TILE_ELEM];
  __nram__ float nram_scaled[TILE_ELEM];
  __nram__ float nram_y[TILE_ELEM];

  for (uint32_t global_start = taskId * TASK_ELEM_SLICE; global_start < total;
       global_start += taskDim * TASK_ELEM_SLICE) {
    uint32_t chunk = total - global_start;
    if (chunk > TASK_ELEM_SLICE) chunk = TASK_ELEM_SLICE;

    for (uint32_t offset = 0; offset < chunk; offset += TILE_ELEM) {
      uint32_t tile = chunk - offset;
      if (tile > TILE_ELEM) tile = TILE_ELEM;

      __memcpy(nram_x, x + global_start + offset, tile * sizeof(float),
               GDRAM2NRAM);

      __bang_mul_scalar(nram_scaled, nram_x, negative_slope, tile);
      __bang_maximum(nram_y, nram_x, nram_scaled, tile);

      __memcpy(y + global_start + offset, nram_y, tile * sizeof(float),
               NRAM2GDRAM);
    }
  }
}

__mlu_entry__ void LeakyReLUHalfKernel(const half *x, half *y, uint32_t total,
                                       half negative_slope) {
  __nram__ half nram_x[TILE_ELEM];
  __nram__ half nram_scaled[TILE_ELEM];
  __nram__ half nram_y[TILE_ELEM];

  for (uint32_t global_start = taskId * TASK_ELEM_SLICE; global_start < total;
       global_start += taskDim * TASK_ELEM_SLICE) {
    uint32_t chunk = total - global_start;
    if (chunk > TASK_ELEM_SLICE) chunk = TASK_ELEM_SLICE;

    for (uint32_t offset = 0; offset < chunk; offset += TILE_ELEM) {
      uint32_t tile = chunk - offset;
      if (tile > TILE_ELEM) tile = TILE_ELEM;

      __memcpy(nram_x, x + global_start + offset, tile * sizeof(half),
               GDRAM2NRAM);

      __bang_mul_scalar(nram_scaled, nram_x, negative_slope, tile);
      __bang_maximum(nram_y, nram_x, nram_scaled, tile);

      __memcpy(y + global_start + offset, nram_y, tile * sizeof(half),
               NRAM2GDRAM);
    }
  }
}

torch::Tensor bang_func(torch::Tensor input, double negative_slope) {
  auto output = input.new_empty(input.sizes());
  uint32_t total = (uint32_t)input.numel();
  if (total == 0) return output;

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t task_dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (input.element_size() == sizeof(float)) {
    LeakyReLUKernel<<<task_dim, ktype, queue>>>(input.data_ptr<float>(),
                                                output.data_ptr<float>(), total,
                                                (float)negative_slope);
  } else {
    LeakyReLUHalfKernel<<<task_dim, ktype, queue>>>(
        (const half *)input.data_ptr(), (half *)output.data_ptr(), total,
        (half)((float)negative_slope));
  }
  return output;
}

void bang_func_raw(float *output, const float *input, int batch, int dim,
                   float negative_slope, cnrtQueue_t queue) {
  uint32_t total = (uint32_t)batch * (uint32_t)dim;
  if (total == 0) return;

  cnrtDim3_t task_dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
  LeakyReLUKernel<<<task_dim, ktype, queue>>>(input, output, total,
                                              negative_slope);
}
