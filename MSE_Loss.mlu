#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>
#include <framework/core/MLUStream.h>

#define TASK_NUM 32
#define FLOAT_TILE_ELEM 8192
#define HALF_TILE_ELEM 8192

__mlu_entry__ void MSEPartialFloatKernel(const float *pred, const float *target,
                                         float *partials, uint32_t total) {
  __nram__ float nram_pred[FLOAT_TILE_ELEM];
  __nram__ float nram_target[FLOAT_TILE_ELEM];
  __nram__ float nram_sum[64];
  float local_sum = 0.0f;

  for (uint32_t start = taskId * FLOAT_TILE_ELEM; start < total;
       start += taskDim * FLOAT_TILE_ELEM) {
    uint32_t tile = total - start;
    if (tile > FLOAT_TILE_ELEM) tile = FLOAT_TILE_ELEM;

    __memcpy(nram_pred, pred + start, tile * sizeof(float), GDRAM2NRAM);
    __memcpy(nram_target, target + start, tile * sizeof(float), GDRAM2NRAM);
    __bang_sub(nram_pred, nram_pred, nram_target, tile);
    __bang_mul(nram_pred, nram_pred, nram_pred, tile);
    __sync_compute();
    for (uint32_t i = 0; i < tile; ++i) {
      local_sum += nram_pred[i];
    }
  }

  nram_sum[0] = local_sum / (float)total;
  __memcpy(partials + taskId, nram_sum, sizeof(float), NRAM2GDRAM);
}

__mlu_entry__ void MSEPartialHalfKernel(const half *pred, const half *target,
                                        half *partials, uint32_t total) {
  __nram__ half nram_pred_h[HALF_TILE_ELEM];
  __nram__ half nram_target_h[HALF_TILE_ELEM];
  __nram__ half nram_partial_h[64];
  __nram__ float nram_pred[HALF_TILE_ELEM];
  __nram__ float nram_target[HALF_TILE_ELEM];
  __nram__ float nram_sum[64];
  float local_sum = 0.0f;

  for (uint32_t start = taskId * HALF_TILE_ELEM; start < total;
       start += taskDim * HALF_TILE_ELEM) {
    uint32_t tile = total - start;
    if (tile > HALF_TILE_ELEM) tile = HALF_TILE_ELEM;

    __memcpy(nram_pred_h, pred + start, tile * sizeof(half), GDRAM2NRAM);
    __memcpy(nram_target_h, target + start, tile * sizeof(half), GDRAM2NRAM);
    __bang_half2float(nram_pred, nram_pred_h, tile);
    __bang_half2float(nram_target, nram_target_h, tile);
    __bang_sub(nram_pred, nram_pred, nram_target, tile);
    __bang_mul(nram_pred, nram_pred, nram_pred, tile);
    __sync_compute();
    for (uint32_t i = 0; i < tile; ++i) {
      local_sum += nram_pred[i];
    }
  }

  nram_sum[0] = local_sum / (float)total;
  __bang_float2half_rn(nram_partial_h, nram_sum, 1);
  __memcpy(partials + taskId, nram_partial_h, sizeof(half), NRAM2GDRAM);
}

__mlu_entry__ void MSEReduceFloatKernel(const float *partials, float *out) {
  __nram__ float nram_partials[64];
  __nram__ float nram_sum[64];

  __memcpy(nram_partials, partials, TASK_NUM * sizeof(float), GDRAM2NRAM);
  __bang_write_value(nram_partials + TASK_NUM, 64 - TASK_NUM, 0.0f);
  __sync_compute();
  nram_sum[0] = 0.0f;
  for (uint32_t i = 0; i < 64; ++i) {
    nram_sum[0] += nram_partials[i];
  }
  __memcpy(out, nram_sum, sizeof(float), NRAM2GDRAM);
}

__mlu_entry__ void MSEReduceHalfKernel(const half *partials, half *out) {
  __nram__ half nram_partials_h[64];
  __nram__ half nram_out_h[64];
  __nram__ float nram_partials[64];
  __nram__ float nram_sum[64];

  __memcpy(nram_partials_h, partials, TASK_NUM * sizeof(half), GDRAM2NRAM);
  __bang_half2float(nram_partials, nram_partials_h, 64);
  __bang_write_value(nram_partials + TASK_NUM, 64 - TASK_NUM, 0.0f);
  __sync_compute();
  nram_sum[0] = 0.0f;
  for (uint32_t i = 0; i < 64; ++i) {
    nram_sum[0] += nram_partials[i];
  }
  __bang_float2half_rn(nram_out_h, nram_sum, 1);
  __memcpy(out, nram_out_h, sizeof(half), NRAM2GDRAM);
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
  auto output = predictions.new_empty({});
  auto partials = predictions.new_empty({TASK_NUM});
  uint32_t total = (uint32_t)predictions.numel();
  if (total == 0) return output;

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t partial_dim = {TASK_NUM, 1, 1};
  cnrtDim3_t reduce_dim = {1, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (predictions.element_size() == sizeof(float)) {
    MSEPartialFloatKernel<<<partial_dim, ktype, queue>>>(
        predictions.data_ptr<float>(), targets.data_ptr<float>(),
        partials.data_ptr<float>(), total);
    MSEReduceFloatKernel<<<reduce_dim, ktype, queue>>>(
        partials.data_ptr<float>(), output.data_ptr<float>());
  } else {
    MSEPartialHalfKernel<<<partial_dim, ktype, queue>>>(
        (const half *)predictions.data_ptr(), (const half *)targets.data_ptr(),
        (half *)partials.data_ptr(), total);
    MSEReduceHalfKernel<<<reduce_dim, ktype, queue>>>(
        (const half *)partials.data_ptr(), (half *)output.data_ptr());
  }
  return output;
}
