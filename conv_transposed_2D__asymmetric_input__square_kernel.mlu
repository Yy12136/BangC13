#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>
#include <framework/core/MLUStream.h>

#define BATCH 16
#define IN_C 32
#define OUT_C 64
#define IN_H 128
#define IN_W 256
#define KERNEL 3
#define OUT_H 130
#define OUT_W 258
#define TILE_PIX 512
#define TASK_NUM 512

__mlu_entry__ void ConvTransposePointwiseKernel(const half *x,
                                                const half *kernel,
                                                float *out) {
  __nram__ half x_h[TILE_PIX * IN_C];
  __nram__ float x_f[TILE_PIX * IN_C];
  __nram__ half k_h[OUT_C * IN_C];
  __nram__ float k_f[OUT_C * IN_C];
  __wram__ float k_w[OUT_C * IN_C];
  __nram__ float y[TILE_PIX * OUT_C];
  __nram__ float acc[TILE_PIX * OUT_C];

  const uint32_t spatial = OUT_H * OUT_W;
  const uint32_t tiles = (spatial + TILE_PIX - 1) / TILE_PIX;
  const uint32_t jobs = BATCH * tiles;

  for (uint32_t job = taskId; job < jobs; job += taskDim) {
    uint32_t tile = job % tiles;
    uint32_t b = job / tiles;
    uint32_t pix0 = tile * TILE_PIX;
    uint32_t count = spatial - pix0;
    if (count > TILE_PIX) count = TILE_PIX;

    __bang_write_value(acc, TILE_PIX * OUT_C, 0.0f);

    for (uint32_t kh = 0; kh < KERNEL; ++kh) {
      for (uint32_t kw = 0; kw < KERNEL; ++kw) {
        for (uint32_t p = 0; p < count; ++p) {
          uint32_t s = pix0 + p;
          uint32_t oh = s / OUT_W;
          uint32_t ow = s - oh * OUT_W;
          int32_t ih = (int32_t)oh - (int32_t)kh;
          int32_t iw = (int32_t)ow - (int32_t)kw;
          for (uint32_t ic = 0; ic < IN_C; ++ic) {
            uint32_t dst = p * IN_C + ic;
            if (ih < 0 || ih >= IN_H || iw < 0 || iw >= IN_W) {
              x_h[dst] = (half)0.0f;
            } else {
              x_h[dst] = x[((uint64_t)b * IN_C + ic) * IN_H * IN_W +
                           (uint32_t)ih * IN_W + (uint32_t)iw];
            }
          }
        }
        __bang_half2float(x_f, x_h, count * IN_C);

        for (uint32_t oc = 0; oc < OUT_C; ++oc) {
          for (uint32_t ic = 0; ic < IN_C; ++ic) {
            k_h[oc * IN_C + ic] =
                kernel[((ic * OUT_C + oc) * KERNEL + kh) * KERNEL + kw];
          }
        }
        __bang_half2float(k_f, k_h, OUT_C * IN_C);
        __memcpy(k_w, k_f, OUT_C * IN_C * sizeof(float), NRAM2WRAM);

        __bang_write_value(y, TILE_PIX * OUT_C, 0.0f);
        __bang_conv(y, x_f, k_w, IN_C, count, 1, 1, 1, 1, 1, OUT_C);
        __bang_add(acc, acc, y, count * OUT_C);
      }
    }

    for (uint32_t p = 0; p < count; ++p) {
      uint32_t s = pix0 + p;
      for (uint32_t oc = 0; oc < OUT_C; ++oc) {
        out[((uint64_t)b * OUT_C + oc) * spatial + s] =
            acc[p * OUT_C + oc];
      }
    }
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels,
                        int out_channels, int kernel_size, int stride,
                        int padding, int output_padding, int groups,
                        bool bias) {
  auto output = torch::empty({x.size(0), out_channels, OUT_H, OUT_W},
                             x.options().dtype(torch::kFloat));
  if (x.numel() == 0) return output;

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t task_dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
  ConvTransposePointwiseKernel<<<task_dim, ktype, queue>>>(
      (const half *)x.data_ptr(), (const half *)kernel.data_ptr(),
      output.data_ptr<float>());
  return output;
}
